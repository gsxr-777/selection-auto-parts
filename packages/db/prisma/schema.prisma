generator client {
  provider = "prisma-client"
  output = "../src/generated"
}
datasource db {
  provider = "postgresql"
}
// Infrastructure placeholder only. Real catalog schema follows source reconnaissance.
model CatalogSource {
  id String @id
  name String
  sourceVersion String?
  licenseNotes String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@map("catalog_sources")
}
